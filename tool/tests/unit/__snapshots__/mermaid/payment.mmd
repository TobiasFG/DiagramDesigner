---
title: "Take payment"
---
flowchart TD
  start(["Start"])
  charge("Charge card")
  ok{"Approved?"}
  paid(["Paid"])
  failed(["Declined"])
  start --> charge
  charge --> ok
  ok -->|"yes"| paid
  ok -->|"no"| failed
  classDef flow_end fill:#cf222e,stroke:none,color:#ffffff
  class paid,failed flow_end
  classDef flow_start fill:#2da44e,stroke:none,color:#ffffff
  class start flow_start
