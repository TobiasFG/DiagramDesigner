---
title: "Checkout"
---
flowchart TD
  subgraph lane_unassigned["(unassigned)"]
    start(["Start"])
    done(["End"])
  end
  subgraph lane_storefront["Storefront"]
    submit[/"Submit cart"/]
    backorder("Offer backorder")
  end
  subgraph lane_order_service["Order Service"]
    validate("Validate cart")
    in_stock{"In stock?"}
    pay[["Take payment"]]
  end
  start --> submit
  submit --> validate
  validate --> in_stock
  in_stock -->|"yes"| pay
  in_stock -->|"no"| backorder
  backorder -.->|"retry"| submit
  pay --> done
  classDef flow_end fill:#cf222e,stroke:none,color:#ffffff
  class done flow_end
  classDef flow_start fill:#2da44e,stroke:none,color:#ffffff
  class start flow_start
