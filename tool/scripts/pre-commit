#!/bin/sh
# Optional git hook: refuse commits with an invalid model or stale exports.
# Install from the repository root with:
#   ln -s ../../tool/scripts/pre-commit .git/hooks/pre-commit
set -e
root=$(git rev-parse --show-toplevel)
if git diff --cached --name-only | grep -qE '^(design/|docs/|sdv\.config\.ts)'; then
	node "$root/tool/cli/bin.js" validate --quiet
	node "$root/tool/cli/bin.js" export --check --quiet || {
		echo "Exports are stale: run 'npm run sdv -- export' in tool/ and stage docs/diagrams." >&2
		exit 1
	}
fi
