  "$defs": {
    "Element": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Kebab-case identifier"
        },
        "name": {
          "description": "Display name; defaults to id",
          "type": [
            "string",
            "number"
          ]
        },
        "description": {
          "type": [
            "string",
            "number"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false,
            "description": "Documentation link"
          }
        },
        "meta": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Free-form string metadata"
        },
        "kind": {
          "type": "string",
          "enum": [
            "person",
            "system",
            "container",
            "component",
            "external",
            "datastore",
            "queue"
          ]
        },
        "technology": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Element"
          }
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false
    },
    "Step": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "Kebab-case identifier"
            },
            "to": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "Kebab-case identifier"
            },
            "msg": {
              "type": [
                "string",
                "number"
              ]
            },
            "kind": {
              "description": "Defaults to sync; self when from = to",
              "type": "string",
              "enum": [
                "sync",
                "async",
                "return",
                "create",
                "destroy",
                "self"
              ]
            },
            "activate": {
              "description": "Activates the receiver until the matching return",
              "type": "boolean"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "note": {
              "type": [
                "string",
                "number"
              ]
            },
            "over": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "description": "Kebab-case identifier"
                },
                {
                  "minItems": 1,
                  "maxItems": 2,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "description": "Kebab-case identifier"
                  }
                }
              ]
            }
          },
          "required": [
            "note",
            "over"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/GroupStep"
        }
      ]
    },
    "GroupStep": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "enum": [
            "alt",
            "opt",
            "loop",
            "par",
            "critical"
          ]
        },
        "label": {
          "type": [
            "string",
            "number"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "else": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "steps": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Step"
                }
              }
            },
            "required": [
              "steps"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "group",
        "steps"
      ],
      "additionalProperties": false
    }
  },
  "title": "System Design Viewer model file"
}
