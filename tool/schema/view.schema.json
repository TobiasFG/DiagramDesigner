{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Kebab-case identifier"
          },
          "type": {
            "type": "string",
            "enum": [
              "component",
              "class",
              "object",
              "flow",
              "pipeline",
              "sequence"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "number"
            ]
          },
          "scope": {
            "description": "Root element; omit for the whole model",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "include": {
            "description": "Ids or globs: \"a.*\" direct children, \"a.**\" descendants, \"tag:x\", \"order-*\"",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depth": {
            "description": "Levels below scope to expand",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "aggregateEdges": {
            "description": "Lift hidden children relationships; default true",
            "type": "boolean"
          },
          "source": {
            "description": "Flow, pipeline or interaction id",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "show": {
            "description": "Class views: toggle compartments",
            "type": "object",
            "properties": {
              "attributes": {
                "type": "boolean"
              },
              "methods": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "layout": {
            "type": "object",
            "properties": {
              "algorithm": {
                "type": "string",
                "enum": [
                  "layered",
                  "stress",
                  "mrtree",
                  "force"
                ]
              },
              "direction": {
                "type": "string",
                "enum": [
                  "RIGHT",
                  "LEFT",
                  "DOWN",
                  "UP"
                ]
              },
              "spacing": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          },
          "export": {
            "type": "object",
            "properties": {
              "formats": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "mermaid",
                    "svg",
                    "png"
                  ]
                }
              },
              "file": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "description": "System Design Viewer view file (*.view.yaml)",
  "title": "System Design Viewer view file"
}
