{
	"name": "system-design-viewer",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"bin": {
		"sdv": "./cli/bin.js"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"sdv": "node cli/bin.js",
		"schema": "node cli/bin.js schema",
		"test:unit": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test": "npm run test:unit && npm run test:e2e"
	},
	"dependencies": {
		"chokidar": "6.0.0",
		"elkjs": "0.12.1",
		"immer": "11.2.9",
		"playwright": "1.65.0",
		"tsx": "4.23.15",
		"yaml": "2.9.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.1.0",
		"@xyflow/svelte": "1.7.1",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.7",
		"vitest": "5.1.0"
	},
	"overrides": {
		"minimatch": "11.0.5"
	}
}
