{
	"name": "system-design",
	"private": true,
	"description": "Design model plus the System Design Viewer (in tool/).",
	"scripts": {
		"postinstall": "cd tool && bun install",
		"dev": "npm --prefix tool run dev",
		"dev:commerce": "SDV_ROOT=../examples/commerce npm --prefix tool run dev",
		"dev:posl": "SDV_CONFIG=../../posl/sdv.config.ts npm --prefix tool run dev",
		"sdv": "node tool/cli/bin.js",
		"validate": "node tool/cli/bin.js validate",
		"export": "node tool/cli/bin.js export",
		"test": "npm --prefix tool test"
	}
}
